# MangaReader Pro Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Choose your database type: 'supabase' or 'mysql'
DATABASE_TYPE=supabase

# Supabase Configuration (if using Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# MySQL Configuration (if using MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mangareader
MYSQL_USERNAME=your-username
MYSQL_PASSWORD=your-password
MYSQL_SSL=false

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Basic Site Information
SITE_NAME="Your Manga Site"
SITE_DESCRIPTION="Professional manga reading platform"
SITE_URL=https://yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Branding
SITE_LOGO_URL=/logo.png
HERO_IMAGE_URL=/hero-bg.jpg
THEME_COLOR=#3b82f6

# =============================================================================
# FEATURES & FUNCTIONALITY
# =============================================================================

# User Management
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
DEFAULT_USER_ROLE=user

# Content Management
MAX_UPLOAD_SIZE_MB=10
ENABLE_COMMENTS=true
ENABLE_BOOKMARKS=true

# Monetization (set to false to disable)
ENABLE_MONETIZATION=false
MONTHLY_PREMIUM_PRICE=9.99
YEARLY_PREMIUM_PRICE=99.99

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Analytics (optional)
ENABLE_ANALYTICS=false
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
PLAUSIBLE_DOMAIN=yourdomain.com

# SEO (optional)
GOOGLE_SITE_VERIFICATION=your-verification-code
BING_SITE_VERIFICATION=your-verification-code

# Social Media (for Open Graph)
TWITTER_HANDLE=@yourmanga
FACEBOOK_APP_ID=your-facebook-app-id

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================

# Security
SESSION_SECRET=your-long-random-session-secret
JWT_SECRET=your-jwt-secret-key
ENABLE_RATE_LIMITING=true

# Performance
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
CDN_URL=https://cdn.yourdomain.com

# =============================================================================
# EMAIL CONFIGURATION (if using custom SMTP)
# =============================================================================

# Email Settings (optional - Supabase handles this automatically)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# CLOUD STORAGE (optional)
# =============================================================================

# Cloudflare R2 or AWS S3 (optional - for additional storage)
STORAGE_PROVIDER=supabase
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_BUCKET=your-bucket-name

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment
NODE_ENV=production
DEBUG_MODE=false
LOG_LEVEL=info

# Development Tools (disable in production)
ENABLE_DEV_TOOLS=false
ENABLE_HOT_RELOAD=false

# =============================================================================
# LICENSING (CodeCanyon)
# =============================================================================

# License Information
PURCHASE_CODE=your-envato-purchase-code
LICENSE_DOMAIN=yourdomain.com

# =============================================================================
# DOCKER CONFIGURATION (if using Docker)
# =============================================================================

# Docker Environment
CONTAINER_PORT=3000
DOCKER_COMPOSE_VERSION=3.8

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site is temporarily down for maintenance"

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Feature Flags
ENABLE_PREMIUM_FEATURES=false
ENABLE_CONTEST_SYSTEM=false
ENABLE_COIN_SYSTEM=false
ENABLE_ADVANCED_THEMING=true

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=false
LIGHTHOUSE_SCORE_THRESHOLD=80

# Content Delivery
IMAGE_OPTIMIZATION=true
LAZY_LOADING=true
SERVICE_WORKER=true

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique passwords and secrets
# 3. Set NODE_ENV=production for live sites
# 4. Regularly rotate secrets and API keys
# 5. Enable HTTPS in production
# 6. Configure your firewall appropriately
# 7. Set up monitoring and backup systems
# 8. Test all functionality after configuration changes
#