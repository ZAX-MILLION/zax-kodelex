# Zax Million — Environment Configuration
# Copy to .env and adjust per deployment target.
# NEVER put secrets (service role keys, PayPal secret) in VITE_* variables.

# =============================================================================
# DEPLOYMENT TARGET (pick one matrix row)
# =============================================================================
# demo       — GitHub Pages public showcase (no DB, no payments, no admin)
# staging    — Vercel/Netlify + staging Supabase + PayPal sandbox
# production — Live site + production Supabase + verified PayPal
#
# VITE_APP_ENV=demo
# VITE_APP_ENV=staging
# VITE_APP_ENV=production

# Legacy demo flag (sets environment to demo when VITE_APP_ENV is unset)
# VITE_DEMO_MODE=true

# Skip first-run setup wizard when credentials are already configured
# VITE_SKIP_SETUP=true

# =============================================================================
# FEATURE GUARDS (recommended for demo / Pages CI)
# =============================================================================
# VITE_DISABLE_PAYMENTS=true
# VITE_DISABLE_ADMIN=true

# Allow /buy simulated checkout — NEVER on production (staging/dev only)
# VITE_ALLOW_SIMULATED_BUY=true

# =============================================================================
# SUPABASE (frontend — anon key only)
# =============================================================================
# Omit entirely on GitHub Pages demo builds.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# PUBLIC INTEGRATIONS (safe for client bundle)
# =============================================================================
# PayPal client ID for Support donate button — omit on demo
# VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# Canonical site URL for SEO (production domain when live)
# VITE_SITE_URL=https://zaxmillion.com

# Vite base path for GitHub Pages:
#   Project site (current): /zax-kodelex/
#   User site root (future): /
# VITE_BASE=/zax-kodelex/
# VITE_BASE=/

# Optional error monitoring
# VITE_SENTRY_DSN=

# =============================================================================
# SERVER-ONLY (Supabase Edge Functions — set in Supabase dashboard, NOT here)
# =============================================================================
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# SUPABASE_SERVICE_ROLE_KEY=
