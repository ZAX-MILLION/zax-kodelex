# Zax Million — Environment Configuration
# Copy this file to .env and fill in your values before running the app.

# =============================================================================
# REQUIRED — Supabase (frontend)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# OPTIONAL — Features & integrations
# =============================================================================

# Skip the first-run setup wizard (use only when env vars are already set)
# VITE_SKIP_SETUP=true

# Show demo library when the database is empty (development / staging only)
# VITE_DEMO_MODE=true

# PayPal client ID for donations on the Support page (omit to hide PayPal)
# VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Site URL used in SEO defaults (defaults to window.location.origin)
# VITE_SITE_URL=https://zaxmillion.com

# Optional error monitoring
# VITE_SENTRY_DSN=
